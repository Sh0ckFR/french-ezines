char *valuedump(HKEY rootKey, LPSTR key, LPSTR value)
{
	DWORD Type; HKEY hKey; char *res; unsigned long i;
	if(RegOpenKeyEx(rootKey, key, 0, KEY_ALL_ACCESS, &hKey)!=ERROR_SUCCESS)
